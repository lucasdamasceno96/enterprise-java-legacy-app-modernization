# Copy this file to `.env` and set the values for your local environment.
# The `.env` file is git-ignored and must not be committed.

# --- Secrets ---------------------------------------------------------------
# PostgreSQL password. Required. Do not commit the real value.
POSTGRES_PASSWORD=change-me

# --- Configuration (defaults shown; change only if needed) ----------------
POSTGRES_USER=petclinic
POSTGRES_DB=petclinic
POSTGRES_PORT=5432

SERVER_PORT=8080
PETCLINIC_PORT=8080
PETCLINIC_IMAGE=spring-petclinic:local
